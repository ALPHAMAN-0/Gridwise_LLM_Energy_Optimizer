# Copy to .env for local development. Never commit .env or any real key.
# In production (Render) set these in the dashboard, not in a file.

# Comma-separated Gemini API keys, tried in rotation. Keys created in the same
# Google Cloud project share ONE quota, so extra keys only help if they come
# from different Google accounts/projects. A single key is fine.
GEMINI_API_KEYS=
# Legacy single-key name, still honoured if GEMINI_API_KEYS is empty.
# GEMINI_API_KEY=

# Model cascade, tried left to right when a model errors or is rate-limited.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
# Thinking effort sent to the model. Leave empty to disable thinking entirely.
GEMINI_THINKING_LEVEL=low

# Timeout for one LLM HTTP call, in seconds.
LLM_CALL_TIMEOUT_S=7
# Total time one request may spend on the LLM across all retries, in seconds.
LLM_TOTAL_BUDGET_S=14
# Maximum LLM calls in flight at once across all requests.
LLM_MAX_CONCURRENCY=4

# Entries kept in the in-process interpretation cache.
CACHE_SIZE=512

# Port uvicorn binds to. Render injects its own value at runtime.
PORT=8000
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
